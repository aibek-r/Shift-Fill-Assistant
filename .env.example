# Required for the AI agent. Without it the app runs in deterministic fallback mode.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-5.4-mini
# MAX_AGENT_STEPS=12
# MAX_REPAIR_ATTEMPTS=2
# MAX_RUN_SECONDS=180   # model execution budget: every model call, retry and backoff

# Pins "today" so relative dates such as "tomorrow" or "next week" match the mock shifts
# (October 14-19, 2026) and the saved examples. Remove it to use the real date.
REFERENCE_DATE=2026-10-02
